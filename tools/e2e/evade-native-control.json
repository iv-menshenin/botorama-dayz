{
  "Name": "evade-native-control",
  "Timeout": 30,
  "Comment": "Control: identical timing (spawn+orient+sleeps) but NO evade. Establishes whether the ~1m displacement seen in evade tests is the native sidestep or just bot settling/foot-step drift.",
  "Steps": [
    { "Op": "spawn", "Who": "A", "Pos": [10480.0, 0.0, 10750.0], "Yaw": 90.0 },
    { "Op": "orient", "Who": "A", "Yaw": 90.0 },
    { "Op": "sleep", "Timeout": 1.0 },
    { "Op": "botdump", "Who": "A" },
    { "Op": "sleep", "Timeout": 0.3 },
    { "Op": "botdump", "Who": "A" },
    { "Op": "sleep", "Timeout": 0.7 },
    { "Op": "botdump", "Who": "A" },
    { "Op": "sleep", "Timeout": 0.3 },
    { "Op": "botdump", "Who": "A" },
    { "Op": "sleep", "Timeout": 0.7 },
    { "Op": "botdump", "Who": "A" },
    { "Op": "clearall" }
  ]
}
